# Solis Configuration Template

[server]
port = 8889
base_url = "http://localhost:8889"
read_timeout = "5s"
write_timeout = "10s"
# Language for the UI. Supported: "en" (English), "zh" (Chinese).
# Add new languages by creating a JSON file in internal/i18n/locales/.
language = "en"

[admin]
username = "admin"
# Default password: "admin" — CHANGE THIS IN PRODUCTION!
# Generate a new bcrypt hash using: ./solis --hash-password "your-password"
password_hash = "$2a$10$WXBoF7ZB7fIRl5smdGH9seqlNbXWiCS7ZbGNk0ONb9xjS8499gBpu"
session_hours = 24

[mcp]
# Exposes a Model Context Protocol endpoint at POST /mcp.
enabled = false
# Recommended for MCP clients. Send as Authorization: Bearer <api_key> or X-API-Key.
# Basic auth with the admin username/password is also accepted.
api_key = ""

[database]
path = "./data/solis.db"

[slugs]
length = 4

[upload]
dir = "./data/uploads"
max_size_mb = 50
